# Copy this file to .env.local and fill in your Supabase project's values.
# Find these in the Supabase dashboard: Project Settings → API.
# The anon key is safe to expose client-side — it's designed for this and is
# protected by Row Level Security policies on every table. Never put the
# service_role secret key here or anywhere in client code.

VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# --- Server-only secrets ----------------------------------------------------
# Everything below is read by the functions in api/ and must NEVER be given a
# VITE_ prefix — that prefix is what puts a value into the browser bundle.
# Locally these live in .env (gitignored); in production they're Vercel
# environment variables.

# Public iCal feed (api/calendar.ts) reads the owning user's events past RLS.
SUPABASE_SERVICE_ROLE_KEY=

# AI features (api/ai.ts). Leave blank and the app runs exactly as it does
# without AI: every feature falls back to its non-AI path.
AI_GATEWAY_URL=
AI_GATEWAY_KEY=
AI_MODEL=
