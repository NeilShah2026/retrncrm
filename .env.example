# Copy this file to .env.local and fill in your Supabase project's values.
# Find these in the Supabase dashboard: Project Settings → API.
# The anon key is safe to expose client-side — it's designed for this and is
# protected by Row Level Security policies on every table. Never put the
# service_role secret key here or anywhere in client code.

VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# --- Server-only secrets ----------------------------------------------------
# Everything below is read by the functions in api/ and must NEVER be given a
# VITE_ prefix — that prefix is what puts a value into the browser bundle.
# Locally these live in .env (gitignored); in production they're Vercel
# environment variables.

# Public iCal feed (api/calendar.ts) reads the owning user's events past RLS,
# and Babson verification (api/verify-edu.ts) stamps the unlock into auth
# app_metadata, which only the service role may write.
SUPABASE_SERVICE_ROLE_KEY=

# AI features (api/ai.ts). Leave blank and the app runs exactly as it does
# without AI: every feature falls back to its non-AI path.
AI_GATEWAY_URL=
AI_GATEWAY_KEY=
AI_MODEL=

# --- Web billing (Stripe) -----------------------------------------------------
# Website subscriptions (api/billing.ts, api/stripe-webhook.ts). Run
#   node scripts/stripe-setup.mjs --webhook-url https://www.retrncrm.com/api/stripe-webhook
# with STRIPE_SECRET_KEY set; it creates the products, prices, the $3 intro
# coupon and the portal, and prints every value below. Use sk_test_ keys for
# Preview/Development in Vercel and sk_live_ keys for Production.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_STUDENT_MONTHLY=
STRIPE_PRICE_STUDENT_YEARLY=
STRIPE_PRICE_STANDARD_MONTHLY=
STRIPE_PRICE_STANDARD_YEARLY=
STRIPE_OFFER_COUPON=
STRIPE_PORTAL_CONFIG=

# Optional: extra emails (comma-separated) that see Settings' testing tools,
# like the upgrade-popup preview. Public (VITE_), so it's only a list of
# addresses — never anything secret.
VITE_ADMIN_EMAILS=
