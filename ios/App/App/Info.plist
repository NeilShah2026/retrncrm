<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CFBundleDevelopmentRegion</key>
	<string>en</string>
	<key>CFBundleDisplayName</key>
        <string>Retrn</string>
	<key>CFBundleExecutable</key>
	<string>$(EXECUTABLE_NAME)</string>
	<key>CFBundleIdentifier</key>
	<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<key>CFBundleName</key>
	<string>$(PRODUCT_NAME)</string>
	<key>CFBundlePackageType</key>
	<string>APPL</string>
	<key>CFBundleShortVersionString</key>
	<string>$(MARKETING_VERSION)</string>
	<key>CFBundleVersion</key>
	<string>$(CURRENT_PROJECT_VERSION)</string>
	<key>LSRequiresIPhoneOS</key>
	<true/>
	<key>UILaunchStoryboardName</key>
	<string>LaunchScreen</string>
	<key>UIMainStoryboardFile</key>
	<string>Main</string>
	<key>UIRequiredDeviceCapabilities</key>
	<array>
		<string>armv7</string>
	</array>
	<!-- Portrait-only on iPhone, matching public/manifest.webmanifest's
	     "orientation": "portrait" for the PWA — every mobile layout (the tab
	     bar, safe-area handling, sheet-style dialogs) is designed and tested
	     for portrait only. -->
	<key>UISupportedInterfaceOrientations</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
	</array>
	<key>UISupportedInterfaceOrientations~ipad</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
		<string>UIInterfaceOrientationPortraitUpsideDown</string>
		<string>UIInterfaceOrientationLandscapeLeft</string>
		<string>UIInterfaceOrientationLandscapeRight</string>
	</array>
	<key>UIViewControllerBasedStatusBarAppearance</key>
	<true/>
	<!-- Custom URL scheme Supabase redirects back to after Google OAuth, a
	     magic link, or a signup confirmation — see src/lib/nativeAuth.ts. -->
	<key>CFBundleURLTypes</key>
	<array>
		<dict>
			<key>CFBundleURLName</key>
			<string>com.neilshah.retrn.auth</string>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>com.neilshah.retrn</string>
			</array>
		</dict>
	</array>
	<!-- Only standard HTTPS/TLS (Supabase, the AI gateway) — no custom
	     encryption, so this skips App Store Connect's export-compliance
	     question on every upload. -->
	<key>ITSAppUsesNonExemptEncryption</key>
	<false/>
	<!-- Taking or choosing a contact's photo (ContactFormDialog). -->
	<key>NSCameraUsageDescription</key>
	<string>Retrn uses your camera so you can take a photo for someone in your contacts.</string>
	<key>NSPhotoLibraryUsageDescription</key>
	<string>Retrn uses your photo library so you can choose a photo for someone in your contacts.</string>
	<!-- Say-who-you-met voice capture and dictation in the assistant
	     (src/components/contacts/VoiceCaptureDialog.tsx, src/hooks/useSpeechRecognition.ts). -->
	<key>NSMicrophoneUsageDescription</key>
	<string>Retrn uses your microphone so you can add a contact by speaking instead of typing.</string>
	<key>NSSpeechRecognitionUsageDescription</key>
	<string>Retrn uses speech recognition to turn what you say into a contact, entirely on your device.</string>
</dict>
</plist>
